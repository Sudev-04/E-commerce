# Copy to frontend/.env.local for local development, or set these in Vercel.

# Where the Express backend runs (server-side only; never exposed to the browser)
BACKEND_URL=http://localhost:5000

# Must be the SAME value as JWT_SECRET in the backend. The Next.js middleware uses
# it to verify the signed session token, so the admin role cannot be faked.
# Leave empty in local development to use the shared dev fallback.
JWT_SECRET=
