# Copy to backend/.env and fill in real values for production.
PORT=5000
NODE_ENV=development
# Origin of the Next.js frontend (used for CORS)
FRONTEND_URL=http://localhost:3000

# Long random strings. JWT_SECRET must be identical in the frontend environment.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=7d

# Private password for admin@example.com. Required in production
# (admin sign-in is disabled without it). Local dev default: admin123
ADMIN_PASSWORD=
JWT_REFRESH_EXPIRES_IN=30d
